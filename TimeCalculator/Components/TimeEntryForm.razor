@using TimeCalculator.AiCore
@using TimeCalculator.Core
@using TimeCalculator.Core.Types
@using AIOrchestrator.Core.Types
@inject IJSRuntime JSRuntime
@inject IConsoleLogger ConsoleLogger

<div class="d-flex flex-column flex-lg-row gap-4 align-items-start">
    <!-- Main Form Controls -->
    <div class="d-flex flex-column gap-4" style="width: 100%; @(ShowDebugTooling ? "max-width: 400px;" : "")">
        <div class="@(ShowDebugTooling ? "d-flex flex-column gap-4" : "d-flex flex-wrap gap-4 align-items-start")">
            <!-- Left Group: Time Inputs, Description, and Action Buttons -->
            <div class="d-flex flex-column gap-4" style="@(ShowDebugTooling ? "" : "width: 400px; max-width: 100%;")">
                <!-- Time Inputs Section -->
                <div class="d-flex gap-3 align-items-start">
                    <div class="d-flex flex-column gap-2">
                        <!-- Absolute Time -->
                        <div class="d-flex gap-2 align-items-end">
                            <div class="d-flex flex-column">
                                <label class="form-label mb-1">Hours</label>
                                <input type="text" value="@TimeCalculator.CurrentTimeEntry.Hours.ToString("00")"
                                       @onchange="@(e => TimeCalculator.SetHours(ParseHours(e.Value)))"
                                       class="form-control text-center px-1" style="width: 50px;" maxlength="2" inputmode="numeric"
                                       onfocus="this.select()" />
                            </div>

                            <div class="mb-2 text-muted fw-bold">:</div>

                            <div class="d-flex flex-column">
                                <label class="form-label mb-1">Minutes</label>
                                <input type="text" value="@TimeCalculator.CurrentTimeEntry.Minutes.ToString("00")"
                                       @onchange="@(e => TimeCalculator.SetMinutes(ParseMinutes(e.Value)))"
                                       class="form-control text-center px-1" style="width: 50px;" maxlength="2" inputmode="numeric"
                                       onfocus="this.select()" />
                            </div>
                        </div>

                        <!-- Duration Time (Start In) -->
                        <div class="d-flex flex-column">
                            <label class="form-label mb-1 small text-muted">Start in</label>
                            <div class="d-flex gap-2 align-items-center">
                                <input type="text" value="@TimeCalculator.Duration.Hours.ToString("00")"
                                       @onchange="@(e => TimeCalculator.SetDurationHours(ParseHours(e.Value)))"
                                       class="form-control text-center px-1"
                                       style="width: 50px; height: 31px; font-size: 0.875rem;" maxlength="2" inputmode="numeric"
                                       onfocus="this.select()" />

                                <div class="text-muted fw-bold">:</div>

                                <input type="text" value="@TimeCalculator.Duration.Minutes.ToString("00")"
                                       @onchange="@(e => TimeCalculator.SetDurationMinutes(ParseMinutes(e.Value)))"
                                       class="form-control text-center px-1"
                                       style="width: 50px; height: 31px; font-size: 0.875rem;" maxlength="2" inputmode="numeric"
                                       onfocus="this.select()" />
                            </div>
                        </div>
                    </div>

                    <div class="ms-auto pt-4">
                        <div class="btn-group" role="group" aria-label="Time entry type">
                            <button type="button" class="@GetTypeButtonClass(TimeType.Work)"
                                    aria-pressed="@(IsTypeSelected(TimeType.Work))"
                                    @onclick="() => TimeCalculator.SetType(TimeType.Work)">
                                Work
                            </button>
                            <button type="button" class="@GetTypeButtonClass(TimeType.Break)"
                                    aria-pressed="@(IsTypeSelected(TimeType.Break))"
                                    @onclick="() => TimeCalculator.SetType(TimeType.Break)">
                                Break
                            </button>
                            <button type="button" class="@GetTypeButtonClass(TimeType.DayEnd)"
                                    aria-pressed="@(IsTypeSelected(TimeType.DayEnd))"
                                    @onclick="() => TimeCalculator.SetType(TimeType.DayEnd)">
                                End
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Description Input -->
                <div class="d-flex flex-column">
                    <label class="form-label mb-1">Description</label>
                    <input type="text" value="@TimeCalculator.CurrentTimeEntry.Description"
                           @onchange="@(e => TimeCalculator.SetDescription(ParseString(e.Value)))" class="form-control"
                           placeholder="Optional description…" />
                </div>

                <!-- Action Buttons -->
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="AddTimeEntry">Add Entry</button>
                    <button class="btn btn-outline-primary" @onclick="SetRemainedTime">Remained</button>
                </div>
            </div>

            @if (!ShowDebugTooling)
            {
                <!-- AI Assistant Group (Side-by-side version) -->
                <div class="d-flex flex-column gap-2 flex-grow-1" style="min-width: 280px;">
                    <ModelPicker TimeCalculator="TimeCalculator" OnModelSelected="OnModelSelected"
                                 Disabled="AiInteraction.IsBusy" />
                    <textarea @bind="AiInteraction.UserInput" class="form-control" style="height: 155px;"
                              aria-label="AI instructions" placeholder="e.g., 'add 2 hours of work'"></textarea>
                    <div class="d-flex gap-2 w-100">
                        <button class="btn btn-primary flex-grow-1 d-flex align-items-center justify-content-center gap-2" 
                                @onclick="AiInteraction.AskAsync" disabled="@AiInteraction.IsBusy">
                            <span>Do it!</span>
                            @if (AiInteraction.IsBusy)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                        </button>
                        @if (AiInteraction.IsBusy)
                        {
                            <button class="btn btn-danger" @onclick="AiInteraction.Cancel">Stop</button>
                        }
                    </div>
                </div>
            }
        </div>

        @if (ShowDebugTooling)
        {
            <hr class="my-0 opacity-10" />

            <!-- AI Assistant Group (Original bottom version) -->
            <div class="d-flex flex-column gap-2">
                <ModelPicker TimeCalculator="TimeCalculator" OnModelSelected="OnModelSelected"
                             Disabled="AiInteraction.IsBusy" />
                <textarea @bind="AiInteraction.UserInput" class="form-control" style="height: 120px;"
                          aria-label="AI instructions" placeholder="e.g., 'add 2 hours of work'"></textarea>
                <div class="d-flex gap-2 w-100">
                    <button class="btn btn-primary flex-grow-1 d-flex align-items-center justify-content-center gap-2" 
                            @onclick="AiInteraction.AskAsync" disabled="@AiInteraction.IsBusy">
                        <span>Do it!</span>
                        @if (AiInteraction.IsBusy)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                    </button>
                    @if (AiInteraction.IsBusy)
                    {
                        <button class="btn btn-danger" @onclick="AiInteraction.Cancel">Stop</button>
                    }
                </div>
            </div>
        }
    </div>

    @if (ShowDebugTooling)
    {
        <AiDebugPanels AiInteraction="AiInteraction" />
    }
</div>

@code {
    [Parameter, EditorRequired] public TimeCalculatorProgramm TimeCalculator { get; set; } = default!;
    [Parameter] public bool ShowDebugTooling { get; set; } = true;

    public AiInteraction AiInteraction { get; private set; } = default!;

    [Parameter] public EventCallback OnChanged { get; set; }

    protected override void OnInitialized()
    {
        AiInteraction = new AiInteraction(TimeCalculator, ConsoleLogger);
        AiInteraction.OnContextUpdated += OnContextUpdated;
        AiInteraction.OnBusyChanged += (s, e) => InvokeAsync(StateHasChanged);

        AiInteraction.UserInput = "ok so started at 08:00 working on refactoring auth module, then at eleven twenty took a break, then at 11:40 back to work did frontend component cleanup, then at 13:45 lunch, then at 14:30 back to work till end on api endpoint documentation";
    }

    private bool _lastShowDebugTooling;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _lastShowDebugTooling = ShowDebugTooling;
            if (ShowDebugTooling)
            {
                await JSRuntime.InvokeVoidAsync("setupAutoScroll", "container-debug", "btn-autoscroll-debug");
            }
        }
        else if (ShowDebugTooling && !_lastShowDebugTooling)
        {
            _lastShowDebugTooling = true;
            await JSRuntime.InvokeVoidAsync("setupAutoScroll", "container-debug", "btn-autoscroll-debug");
        }
        else
        {
            _lastShowDebugTooling = ShowDebugTooling;
        }
    }

    private void OnContextUpdated(object? sender, List<FunctionCallResponse> e)
    {
        _ = NotifyChangedAsync();
    }

    private void AddTimeEntry()
    {
        TimeCalculator.AddTimeEntry();
        _ = NotifyChangedAsync();
    }

    private void SetRemainedTime()
    {
        TimeCalculator.SetRemainedTime();
        TimeCalculator.AddTimeEntry();
        _ = NotifyChangedAsync();
    }

    private Task NotifyChangedAsync()
    {
        return OnChanged.HasDelegate ? OnChanged.InvokeAsync() : Task.CompletedTask;
    }

    public bool IsTypeSelected(TimeType type)
    {
        return TimeCalculator.CurrentTimeEntry.Type == type;
    }

    private string GetTypeButtonClass(TimeType type)
    {
        return IsTypeSelected(type) ? "btn btn-primary" : "btn btn-outline-primary";
    }

    private int ParseInt(object? value) => int.TryParse(value?.ToString(), out var v) ? v : 0;
    private int ParseHours(object? value) => Math.Min(23, ParseInt(value));
    private int ParseMinutes(object? value) => Math.Min(59, ParseInt(value));
    private string ParseString(object? value) => value?.ToString() ?? string.Empty;

    private void OnModelSelected(string modelName)
    {
        ReInitializeAi();
    }

    public void ReInitializeAi()
    {
        AiInteraction.Init();
        StateHasChanged();
    }
}
