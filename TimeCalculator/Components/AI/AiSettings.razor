@using TimeCalculator.Core
@using AIOrchestrator.OllamaClient.Types

<div class="card mb-4 border-primary shadow-sm" style="background-color: var(--tc-surface-1);">
    <div class="card-body">
        <h5 class="card-title text-primary"><i class="bi bi-gear-fill me-2"></i>AI Connection Settings</h5>
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label small">Ollama URL</label>
                <input type="text" class="form-control form-control-sm" @bind="TimeCalculator.AiSettings.BaseUrl"
                       placeholder="http://localhost:11434" />
            </div>
            <div class="col-md-4">
                <label class="form-label small">Model Name</label>
                <input type="text" class="form-control form-control-sm" @bind="TimeCalculator.AiSettings.ModelName"
                       placeholder="ministral-3:3b" />
            </div>
        </div>

        <div class="mt-4">
            <h6 class="text-secondary small fw-bold">Available Models (click row to set Model Name)</h6>
            <div class="mb-2">
                <input type="text" class="form-control form-control-sm" placeholder="Search models by name..." @bind="_searchQuery" @bind:event="oninput" />
            </div>
            @if (_isLoadingModels)
            {
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            }
            else if (_modelsError != null)
            {
                <div class="alert alert-danger py-1 px-2 small">@_modelsError</div>
                <button class="btn btn-sm btn-outline-secondary mt-1" @onclick="LoadModelsAsync">Retry</button>
            }
            else if (_availableModels != null && _availableModels.Count > 0)
            {
                var filteredModels = GetFilteredAndSortedModels();
                <div class="table-responsive border rounded" style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-sm table-hover align-middle mb-0 m-0" style="font-size: 0.85rem;">
                        <thead style="position: sticky; top: 0; z-index: 1; background-color: var(--tc-surface-2);">
                            <tr>
                                <th class="ps-2" style="cursor: pointer; user-select: none;" @onclick='() => SortBy("Name")'>
                                    Name 
                                    @if (_sortColumn == "Name") { <span class="ms-1">@(_sortAscending ? "↑" : "↓")</span> }
                                </th>
                                <th style="cursor: pointer; user-select: none;" @onclick='() => SortBy("Parameters")'>
                                    Params 
                                    @if (_sortColumn == "Parameters") { <span class="ms-1">@(_sortAscending ? "↑" : "↓")</span> }
                                </th>
                                <th style="cursor: pointer; user-select: none;" @onclick='() => SortBy("Quantization")'>
                                    Quant 
                                    @if (_sortColumn == "Quantization") { <span class="ms-1">@(_sortAscending ? "↑" : "↓")</span> }
                                </th>
                                <th style="cursor: pointer; user-select: none;" @onclick='() => SortBy("Size")'>
                                    Size 
                                    @if (_sortColumn == "Size") { <span class="ms-1">@(_sortAscending ? "↑" : "↓")</span> }
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (filteredModels != null && filteredModels.Any())
                            {
                                @foreach (var model in filteredModels)
                                {
                                    <tr @onclick="() => UseModel(model.Name)" style="cursor: pointer;">
                                        <td class="ps-2 fw-medium">@model.Name</td>
                                        <td class="text-muted">@(model.Details?.ParameterSize ?? "-")</td>
                                        <td class="text-muted">@(model.Details?.QuantizationLevel ?? "-")</td>
                                        <td class="text-muted">@(Math.Round((double)model.Size / 1024 / 1024 / 1024, 2)) GB</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-2 small text-muted">No models match the search query.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (_availableModels != null && _availableModels.Count == 0)
            {
                <p class="small text-muted mb-0">No models found.</p>
            }
        </div>

        <div class="mt-3 d-flex justify-content-end">
            <button class="btn btn-primary btn-sm" @onclick="SaveSettings">Apply & Reload AI</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TimeCalculatorProgramm TimeCalculator { get; set; } = default!;
    [Parameter] public EventCallback OnSettingsSaved { get; set; }

    private List<OllamaModel>? _availableModels;
    private string? _modelsError;
    private bool _isLoadingModels;
    private string _searchQuery = "";
    private string _sortColumn = "Name";
    private bool _sortAscending = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadModelsAsync();
    }

    private async Task LoadModelsAsync()
    {
        _isLoadingModels = true;
        _modelsError = null;
        StateHasChanged();

        try
        {
            var baseUrl = string.IsNullOrWhiteSpace(TimeCalculator.AiSettings.BaseUrl) ? "http://localhost:11434" : TimeCalculator.AiSettings.BaseUrl;
            _availableModels = await AIOrchestrator.OllamaClient.OllamaModels.GetModelsAsync(baseUrl);
        }
        catch (Exception ex)
        {
            _modelsError = $"Failed to load models: {ex.Message}";
        }
        finally
        {
            _isLoadingModels = false;
            StateHasChanged();
        }
    }

    private void UseModel(string modelName)
    {
        TimeCalculator.AiSettings.ModelName = modelName;
    }

    private async Task SaveSettings()
    {
        if (OnSettingsSaved.HasDelegate)
        {
            await OnSettingsSaved.InvokeAsync();
        }
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private IEnumerable<OllamaModel>? GetFilteredAndSortedModels()
    {
        if (_availableModels == null) return null;

        var query = _availableModels.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            query = query.Where(m => m.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
        }

        return _sortColumn switch
        {
            "Name" => _sortAscending ? query.OrderBy(m => m.Name) : query.OrderByDescending(m => m.Name),
            "Size" => _sortAscending ? query.OrderBy(m => m.Size) : query.OrderByDescending(m => m.Size),
            "Parameters" => _sortAscending ? query.OrderBy(m => GetParameterSortValue(m.Details?.ParameterSize)) : query.OrderByDescending(m => GetParameterSortValue(m.Details?.ParameterSize)),
            "Quantization" => _sortAscending ? query.OrderBy(m => m.Details?.QuantizationLevel) : query.OrderByDescending(m => m.Details?.QuantizationLevel),
            _ => query
        };
    }

    private double GetParameterSortValue(string? paramSize)
    {
        if (string.IsNullOrWhiteSpace(paramSize)) return 0;
        
        var numStr = new string(paramSize.TakeWhile(c => char.IsDigit(c) || c == '.').ToArray());
        if (double.TryParse(numStr, System.Globalization.CultureInfo.InvariantCulture, out var num))
        {
            if (paramSize.EndsWith("M", StringComparison.OrdinalIgnoreCase)) return num * 0.001;
            return num;
        }
        return 0;
    }
}
