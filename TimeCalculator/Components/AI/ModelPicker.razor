@using TimeCalculator.Core
@inject IJSRuntime JSRuntime

<div class="d-flex flex-wrap align-items-center gap-2" title="@_modelsError">
    <div @ref="_pickerElement" class="d-flex flex-wrap gap-1" role="group" aria-label="AI model">
        @foreach (var modelName in _modelNames)
        {
            <button type="button"
                    data-model-name="@modelName"
                    class="@GetButtonClass(modelName)"
                    aria-pressed="@IsSelected(modelName)"
                    disabled="@Disabled"
                    @onclick="() => SelectModelAsync(modelName)">
                @modelName
            </button>
        }
    </div>
    @if (_isLoadingModels)
    {
        <span class="spinner-border spinner-border-sm text-muted" role="status">
            <span class="visually-hidden">Loading models...</span>
        </span>
    }
</div>

@code {
    [Parameter, EditorRequired] public TimeCalculatorProgramm TimeCalculator { get; set; } = default!;
    [Parameter] public EventCallback<string> OnModelSelected { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private readonly List<string> _modelNames = [];
    private ElementReference _pickerElement;
    private bool _isLoadingModels;
    private bool _needsPacking;
    private string? _modelsError;

    protected override void OnParametersSet()
    {
        AddModelName(TimeCalculator.AiSettings.ModelName);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadModelsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isLoadingModels || !_needsPacking || _modelNames.Count < 2)
        {
            return;
        }

        _needsPacking = false;
        var packedNames = await JSRuntime.InvokeAsync<string[]>("getPackedButtonOrder", _pickerElement);

        if (packedNames.Length == _modelNames.Count
            && !packedNames.SequenceEqual(_modelNames, StringComparer.OrdinalIgnoreCase))
        {
            _modelNames.Clear();
            _modelNames.AddRange(packedNames);
            StateHasChanged();
        }
    }

    private async Task LoadModelsAsync()
    {
        _isLoadingModels = true;

        try
        {
            var baseUrl = string.IsNullOrWhiteSpace(TimeCalculator.AiSettings.BaseUrl)
                ? "http://localhost:11434"
                : TimeCalculator.AiSettings.BaseUrl;

            var availableModels = await AIOrchestrator.OllamaClient.OllamaModels.GetModelsAsync(baseUrl);
            foreach (var model in availableModels)
            {
                AddModelName(model.Name);
            }
        }
        catch (Exception ex)
        {
            _modelsError = $"Could not load Ollama models: {ex.Message}";
        }
        finally
        {
            _isLoadingModels = false;
        }
    }

    private void AddModelName(string modelName)
    {
        if (!string.IsNullOrWhiteSpace(modelName)
            && !_modelNames.Contains(modelName, StringComparer.OrdinalIgnoreCase))
        {
            _modelNames.Add(modelName);
            _needsPacking = true;
        }
    }

    private bool IsSelected(string modelName) =>
        string.Equals(modelName, TimeCalculator.AiSettings.ModelName, StringComparison.OrdinalIgnoreCase);

    private string GetButtonClass(string modelName) =>
        IsSelected(modelName) ? "btn btn-sm btn-primary" : "btn btn-sm btn-outline-primary";

    private async Task SelectModelAsync(string modelName)
    {
        if (IsSelected(modelName))
        {
            return;
        }

        TimeCalculator.AiSettings.ModelName = modelName;
        await OnModelSelected.InvokeAsync(modelName);
    }
}
